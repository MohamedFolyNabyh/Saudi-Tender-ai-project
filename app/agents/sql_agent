from sqlalchemy.orm import Session
from app.database.models.project import Project
from app.database.models.tender import Tender


class SQLAgent:

    @classmethod
    def run(cls, question: str, db: Session) -> str:
        q = question.lower()

        # 1. عدد المناقصات
        if any(k in q for k in ["how many tender", "number of tender", "عدد المناقص"]):
            return f"There are {db.query(Tender).count()} tenders in the system."

        # 2. عدد المشاريع
        if any(k in q for k in ["how many project", "number of project", "عدد المشاريع"]):
            return f"There are {db.query(Project).count()} projects in the system."

        # 3. عرض قائمة المناقصات
        if any(k in q for k in ["list tenders", "show tenders", "all tenders", "كل المناقص", "المناقصات"]):
            tenders = db.query(Tender).all()
            if not tenders:
                return "No tenders found."
            return "\n".join(f"- {t.tender_name}" for t in tenders)

        # 4. حالة المناقصات
        if any(k in q for k in ["status", "حالة"]):
            tenders = db.query(Tender).all()
            if not tenders:
                return "No tenders found."
            return "\n".join(
                f"- {t.tender_name}: {getattr(t.status, 'value', t.status)}"
                for t in tenders
            ) 

        # 5. رد افتراضي
        return "I could not determine a suitable database query for this question."